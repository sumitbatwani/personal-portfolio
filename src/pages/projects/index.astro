---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Projects — Sumit Kumar" description="Software projects built by Sumit Kumar — a lead software engineer with 10+ years of experience.">
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">Work</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">Projects</h1>
      <p class="text-lg text-slate-500 dark:text-slate-400 mb-16">
        A collection of projects I've built — from side experiments to production systems at scale.
      </p>

      <div class="flex flex-col items-center justify-center py-24 text-center">
        <div class="w-16 h-16 rounded-2xl bg-brand-50 dark:bg-brand-900/30
                    flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-500" fill="none"
               viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
        </div>
        <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-2">
          Projects being documented
        </h2>
        <p class="text-slate-500 dark:text-slate-400 max-w-sm">
          Full project details are being written up. In the meantime, check out
          <a href="https://github.com/sumitkumar" target="_blank" rel="noopener noreferrer"
             class="text-brand-600 dark:text-brand-400 hover:underline underline-offset-4">
            my GitHub
          </a> for code.
        </p>
        <a href="/" class="mt-6 text-sm text-slate-500 hover:text-brand-600 dark:hover:text-brand-400
                           transition-colors">
          ← Back home
        </a>
      </div>
    </div>
  </section>
</Layout>
