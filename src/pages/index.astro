---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

function readingTime(body: string): number {
  return Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));
}
function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Layout>
  <!-- ═══════════════════════════════════════════════ HERO -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">

    <!-- Background grid pattern -->
    <div
      class="absolute inset-0 -z-10
             [background-image:linear-gradient(to_right,theme(colors.slate.200/40)_1px,transparent_1px),linear-gradient(to_bottom,theme(colors.slate.200/40)_1px,transparent_1px)]
             dark:[background-image:linear-gradient(to_right,theme(colors.slate.800/40)_1px,transparent_1px),linear-gradient(to_bottom,theme(colors.slate.800/40)_1px,transparent_1px)]
             [background-size:48px_48px]"
      aria-hidden="true"
    />

    <!-- Gradient blur blob -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 -z-10
             w-[600px] h-[600px] rounded-full opacity-20 dark:opacity-10
             bg-brand-400 blur-[120px] pointer-events-none"
      aria-hidden="true"
    />

    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-24">
      <!-- Availability badge -->
      <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 px-3 py-1.5
                  rounded-full border border-emerald-200 dark:border-emerald-800
                  bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400
                  text-xs font-medium">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Open to new opportunities
      </div>

      <!-- Heading -->
      <h1 class="animate-fade-in-up delay-100 text-5xl sm:text-6xl lg:text-7xl font-bold
                 text-slate-900 dark:text-white leading-[1.1] tracking-tight">
        Hi, I'm<br />
        <span class="text-brand-500">Sumit Kumar</span>
      </h1>

      <!-- Subheading -->
      <p class="animate-fade-in-up delay-200 mt-6 text-xl sm:text-2xl font-medium
                text-slate-600 dark:text-slate-300">
        Lead Software Engineer
      </p>

      <!-- Description -->
      <p class="animate-fade-in-up delay-300 mt-4 max-w-2xl text-lg text-slate-500 dark:text-slate-400
                leading-relaxed">
        Software engineer with a passion for building user-focused, high-impact software —
        from intuitive interfaces to scalable backend architecture. I craft elegant,
        efficient solutions that solve real-world problems.
      </p>

      <!-- CTA buttons -->
      <div class="animate-fade-in-up delay-400 mt-10 flex flex-wrap gap-4">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                 bg-brand-600 hover:bg-brand-700 text-white
                 shadow-lg shadow-brand-500/30 hover:shadow-brand-500/40
                 transition-all duration-200 hover:-translate-y-0.5"
        >
          View Projects
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
               viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200
                 border border-slate-200 dark:border-slate-700
                 hover:border-brand-400 dark:hover:border-brand-500 hover:text-brand-600 dark:hover:text-brand-400
                 shadow-sm hover:shadow-md
                 transition-all duration-200 hover:-translate-y-0.5"
        >
          Read Blog
        </a>
      </div>

      <!-- Quick stats -->
      <div class="animate-fade-in-up delay-500 mt-16 flex flex-wrap gap-8">
        {[
          { value: '10+', label: 'Years experience' },
          { value: '3',   label: 'Companies worked at' },
          { value: '2',   label: 'SaaS products shipped' },
        ].map(({ value, label }) => (
          <div>
            <p class="text-3xl font-bold text-slate-900 dark:text-white">{value}</p>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ ABOUT -->
  <section id="about" class="py-24 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">

        <!-- Text -->
        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">
            About me
          </p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-6">
            Building things that scale
          </h2>
          <div class="space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed">
            <p>
              I'm a software engineer with a passion for building user-focused, high-impact
              software. From intuitive interfaces to scalable backend architecture, I enjoy
              crafting elegant, efficient solutions that solve real-world problems.
            </p>
            <p>
              With hands-on experience leading engineering teams and shipping end-to-end
              products, I thrive in fast-paced environments where clean code, thoughtful
              design, and collaboration drive innovation.
            </p>
            <p>
              When I'm not writing code, I'm writing about it — sharing lessons learned
              from real engineering challenges on my blog.
            </p>
          </div>
          <div class="mt-8 flex gap-4">
            <a href="/about"
               class="text-sm font-semibold text-brand-600 dark:text-brand-400
                      hover:underline underline-offset-4 transition-colors">
              More about me →
            </a>
            <a href="/resume.pdf"
               class="text-sm font-semibold text-slate-500 dark:text-slate-400
                      hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Download résumé →
            </a>
          </div>
        </div>

        <!-- Skills grid -->
        <div id="skills">
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-4">
            Tech I work with
          </p>
          <div class="grid grid-cols-2 gap-3">
            {[
              { category: 'Languages',     items: ['TypeScript', 'JavaScript', 'Python'] },
              { category: 'Frontend',      items: ['React.js', 'Tailwind CSS', 'Astro'] },
              { category: 'Backend',       items: ['FastAPI', 'REST APIs', 'Async Python'] },
              { category: 'Infra / Cloud', items: ['AWS', 'GCP', 'Docker', 'Kubernetes'] },
              { category: 'Databases',     items: ['PostgreSQL', 'MongoDB'] },
              { category: 'Practices',     items: ['CI/CD', 'System Design', 'Agile'] },
            ].map(({ category, items }) => (
              <div class="p-3 rounded-xl bg-white dark:bg-slate-800
                          border border-slate-200 dark:border-slate-700
                          hover:border-brand-300 dark:hover:border-brand-700
                          transition-colors duration-150">
                <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 mb-2 uppercase tracking-wide">
                  {category}
                </p>
                <div class="flex flex-wrap gap-1">
                  {items.map(item => (
                    <span class="text-xs px-2 py-0.5 rounded-md
                                 bg-slate-100 dark:bg-slate-700
                                 text-slate-700 dark:text-slate-300 font-medium">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ PROJECTS -->
  <section id="projects" class="py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">Work</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
            Featured Projects
          </h2>
        </div>
        <a href="/projects"
           class="hidden sm:inline-flex text-sm font-semibold text-brand-600 dark:text-brand-400
                  hover:underline underline-offset-4 transition-colors whitespace-nowrap">
          View all →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            title: 'Meeting Scheduling SaaS',
            description: 'Full-stack scheduling platform with real-time availability sync across Google, Outlook, and Apple Calendar. A custom time-slot algorithm cut scheduling load time by 30%. Deployed globally via AWS (S3, CloudFront, Route 53) with APIs on GCP using Docker & Kubernetes.',
            tags: ['React.js', 'TypeScript', 'FastAPI', 'MongoDB', 'AWS', 'GCP', 'Kubernetes'],
            github: null,
            live: null,
          },
          {
            title: 'ArticleX',
            description: 'AI-powered SaaS that repurposes content from YouTube, Instagram, and Apple Podcasts into blog articles and summaries. Built for async processing with FastAPI + PostgreSQL, deployed on AWS with full CI/CD pipelines.',
            tags: ['React.js', 'TypeScript', 'FastAPI', 'PostgreSQL', 'AWS', 'Python', 'AI'],
            github: null,
            live: null,
          },
        ].map(({ title, description, tags, github, live }) => (
          <article
            class="group flex flex-col rounded-2xl border border-slate-200 dark:border-slate-800
                   bg-white dark:bg-slate-900
                   hover:border-brand-300 dark:hover:border-brand-700
                   hover:shadow-xl hover:shadow-brand-500/5
                   transition-all duration-200 overflow-hidden"
          >
            <div class="h-44 bg-gradient-to-br from-brand-50 via-slate-100 to-slate-200
                        dark:from-brand-950/30 dark:via-slate-800 dark:to-slate-900
                        flex items-center justify-center">
              <span class="text-4xl font-bold text-brand-200 dark:text-brand-800/60 select-none">
                {title.charAt(0)}
              </span>
            </div>

            <div class="flex flex-col flex-1 p-5">
              <h3 class="font-bold text-lg text-slate-900 dark:text-white
                         group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                {title}
              </h3>
              <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed flex-1">
                {description}
              </p>

              <div class="mt-4 flex flex-wrap gap-1.5">
                {tags.map(tag => (
                  <span class="text-xs px-2 py-0.5 rounded-md font-medium
                               bg-brand-50 dark:bg-brand-900/30
                               text-brand-700 dark:text-brand-300
                               border border-brand-100 dark:border-brand-800">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-5 flex gap-3">
                <a href={github} target="_blank" rel="noopener noreferrer"
                   class="flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400
                          hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
                {live && (
                  <a href={live} target="_blank" rel="noopener noreferrer"
                     class="flex items-center gap-1.5 text-xs font-semibold text-slate-600 dark:text-slate-400
                            hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    Live Demo
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ BLOG TEASER -->
  <section id="blog" class="py-24 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">Writing</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
            From the Blog
          </h2>
        </div>
        <a href="/blog"
           class="hidden sm:inline-flex text-sm font-semibold text-brand-600 dark:text-brand-400
                  hover:underline underline-offset-4 transition-colors">
          All posts →
        </a>
      </div>

      <div class="space-y-4">
        {latestPosts.map(post => {
          const slug = post.id.replace(/\.(md|mdx)$/, '');
          const rt   = readingTime(post.body ?? '');
          return (
            <a
              href={`/blog/${slug}`}
              class="group flex items-start gap-4 p-5 rounded-2xl
                     bg-white dark:bg-slate-900
                     border border-slate-200 dark:border-slate-800
                     hover:border-brand-300 dark:hover:border-brand-700
                     hover:shadow-lg hover:shadow-brand-500/5
                     transition-all duration-200 block"
            >
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  {post.data.tags.slice(0, 3).map(tag => (
                    <span class="text-xs font-medium text-brand-600 dark:text-brand-400">{tag}</span>
                  ))}
                  <span class="text-slate-300 dark:text-slate-700">·</span>
                  <span class="text-xs text-slate-400">{rt} min read</span>
                </div>
                <h3 class="font-semibold text-slate-900 dark:text-white leading-snug
                           group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-xs text-slate-400 mt-1.5">{formatDate(post.data.date)}</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg"
                   class="h-5 w-5 text-slate-300 dark:text-slate-700 shrink-0 mt-0.5
                          group-hover:text-brand-500 group-hover:translate-x-1 transition-all duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ CONTACT -->
  <section id="contact" class="py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">
        Get in touch
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mb-4">
        Let's work together
      </h2>
      <p class="text-lg text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-10">
        Whether it's a full-time role, a contract engagement, or just a technical
        conversation — I'd love to hear from you.
      </p>
      <a
        href="mailto:sumitbatwani@gmail.com"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-xl font-semibold text-base
               bg-brand-600 hover:bg-brand-700 text-white
               shadow-xl shadow-brand-500/30 hover:shadow-brand-500/50
               transition-all duration-200 hover:-translate-y-0.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
             viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        Say Hello
      </a>
    </div>
  </section>
</Layout>
