---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    company: 'Codebase',
    location: 'Pune, India',
    url: null,
    roles: [
      { title: 'Lead Software Engineer', period: 'Apr 2025 – Present', current: true },
      { title: 'Senior Software Engineer', period: 'Nov 2021 – Apr 2025', current: false },
    ],
    duration: '4 yrs 4 months',
    projects: [
      {
        name: 'Meeting Scheduling SaaS',
        bullets: [
          'Developed RESTful APIs using FastAPI with MongoDB backend.',
          'Built frontend with React.js, TypeScript, and Tailwind CSS.',
          'Deployed frontend on AWS (S3, Route 53, CloudFront) for global delivery.',
          'Containerized and deployed APIs on GCP using Docker & Kubernetes.',
          'Improved a time-slot algorithm reducing scheduling load time by 30%.',
          'Integrated Google, Outlook, and Apple Calendar APIs for real-time availability sync.',
        ],
      },
      {
        name: 'ArticleX – AI-Powered Content Repurposing SaaS',
        bullets: [
          'Designed and built full-stack SaaS to repurpose content from YouTube, Instagram, and Apple Podcasts into blog articles and summaries using AI.',
          'Developed backend with FastAPI and PostgreSQL, optimised for asynchronous processing.',
          'Built responsive frontend using React.js, TypeScript, and Tailwind CSS.',
          'Deployed on AWS (EC2, S3, Route 53, CloudFront) with CI/CD pipelines.',
          'Architected for modularity to support rapid feature iteration.',
        ],
      },
    ],
  },
  {
    company: 'Tyroo',
    location: 'Gurugram, India',
    url: null,
    roles: [
      { title: 'Lead Software Development Engineer', period: 'Oct 2020 – Nov 2021', current: false },
      { title: 'Software Development Engineer', period: 'Jan 2019 – Oct 2020', current: false },
    ],
    duration: '2 yrs 11 months',
    projects: [
      {
        name: 'Frontend Development',
        bullets: [
          'Built frontend dashboards and data-rich UI using React.js and TypeScript.',
          'Leveraged Material UI and Ant Design component libraries for consistent, scalable interfaces.',
        ],
      },
    ],
  },
  {
    company: 'NTT Data',
    location: 'Bangalore, India',
    url: null,
    roles: [
      { title: 'Application Software Developer', period: 'Dec 2015 – Jan 2019', current: false },
    ],
    duration: '3 yrs 2 months',
    projects: [],
  },
];

const education = [
  {
    institution: 'Liverpool John Moores University',
    degree: "Master's degree",
    field: 'Computer Science',
    period: '2024 – 2025',
  },
  {
    institution: 'International Institute of Information Technology Bangalore',
    degree: 'Postgraduate Degree',
    field: 'Computer Science',
    period: '2023 – 2024',
  },
  {
    institution: 'Sharda University',
    degree: "Bachelor's degree",
    field: 'Computer Science',
    period: '2012 – 2015',
  },
];

const certifications = [
  { name: 'Oracle Certification — Java Professional SE 6', issuer: 'Oracle', year: '2015' },
  { name: 'Oracle Certification — Java Associate SE 6',   issuer: 'Oracle', year: '2015' },
  { name: 'React & TypeScript Chrome Extension Development', issuer: 'Udemy', year: '2023' },
  { name: 'FastAPI — Beginner + Advanced',                issuer: 'Udemy', year: '2023' },
];
---

<Layout
  title="About — Sumit Kumar"
  description="Lead Software Engineer with 10+ years of experience. Explore my background, work history, education, and certifications."
>
  <!-- ═══════════════════════════════════════════════ HEADER -->
  <section class="py-16 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">

        <div>
          <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">About</p>
          <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">
            Sumit Kumar
          </h1>
          <p class="text-xl text-slate-500 dark:text-slate-400 font-medium">
            Lead Software Engineer
          </p>
          <div class="flex items-center gap-1.5 mt-3 text-sm text-slate-400 dark:text-slate-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Mumbai, Maharashtra, India
          </div>
        </div>

        <!-- Quick actions -->
        <div class="flex flex-wrap gap-3 sm:flex-col sm:items-end">
          <a
            href="mailto:sumitbatwani@gmail.com"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold
                   bg-brand-600 hover:bg-brand-700 text-white transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Get in touch
          </a>
          <a
            href="/resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold
                   bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200
                   border border-slate-200 dark:border-slate-700
                   hover:border-brand-400 dark:hover:border-brand-500
                   transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
            </svg>
            Download résumé
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ SUMMARY -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-3 gap-10">

        <!-- Bio -->
        <div class="md:col-span-2">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Summary</h2>
          <div class="space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed">
            <p>
              Software Engineer with a passion for building user-focused, high-impact software.
              From intuitive interfaces to scalable backend architecture, I enjoy crafting elegant,
              efficient solutions that solve real-world problems.
            </p>
            <p>
              With hands-on experience leading engineering teams and shipping end-to-end products,
              I thrive in fast-paced environments where clean code, thoughtful design, and
              collaboration drive innovation.
            </p>
          </div>
        </div>

        <!-- Quick facts -->
        <div class="space-y-5">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Quick facts</h2>

          {[
            { label: 'Experience', value: '10+ years' },
            { label: 'Current role', value: 'Lead Software Engineer' },
            { label: 'Location', value: 'Mumbai, India' },
            { label: 'Education', value: 'MSc Computer Science' },
          ].map(({ label, value }) => (
            <div>
              <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wide mb-0.5">
                {label}
              </p>
              <p class="text-sm font-medium text-slate-700 dark:text-slate-300">{value}</p>
            </div>
          ))}

          <!-- Top skills -->
          <div>
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wide mb-2">
              Top skills
            </p>
            <div class="flex flex-wrap gap-1.5">
              {['Technical Architecture', 'Systems Design', 'SDKs', 'Team Leadership'].map(s => (
                <span class="text-xs px-2 py-0.5 rounded-md font-medium
                             bg-brand-50 dark:bg-brand-900/30
                             text-brand-700 dark:text-brand-300
                             border border-brand-100 dark:border-brand-800">
                  {s}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ EXPERIENCE -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-10">Work Experience</h2>

      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-4 top-2 bottom-2 w-px bg-slate-200 dark:bg-slate-800"
             aria-hidden="true" />

        <div class="space-y-10">
          {experience.map(({ company, location, duration, roles, projects }) => (
            <div class="relative pl-12">
              <!-- Dot -->
              <div class="absolute left-0 top-1 w-8 h-8 rounded-full
                          bg-white dark:bg-slate-900
                          border-2 border-brand-500
                          flex items-center justify-center text-xs font-bold text-brand-600 dark:text-brand-400
                          shadow-sm">
                {company.charAt(0)}
              </div>

              <!-- Company header -->
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-3">
                <div>
                  <h3 class="text-lg font-bold text-slate-900 dark:text-white">{company}</h3>
                  <div class="flex items-center gap-2 mt-0.5">
                    <span class="text-sm text-slate-500 dark:text-slate-400">{location}</span>
                    <span class="text-slate-300 dark:text-slate-700">·</span>
                    <span class="text-sm text-slate-400 dark:text-slate-500">{duration}</span>
                  </div>
                </div>
              </div>

              <!-- Roles -->
              <div class="space-y-1 mb-4">
                {roles.map(({ title, period, current }) => (
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{title}</span>
                    {current && (
                      <span class="text-xs px-1.5 py-0.5 rounded-full font-medium
                                   bg-emerald-100 dark:bg-emerald-900/30
                                   text-emerald-700 dark:text-emerald-400
                                   border border-emerald-200 dark:border-emerald-800">
                        Current
                      </span>
                    )}
                    <span class="text-xs text-slate-400 dark:text-slate-500">{period}</span>
                  </div>
                ))}
              </div>

              <!-- Projects & bullets -->
              {projects.length > 0 && (
                <div class="space-y-5">
                  {projects.map(({ name, bullets }) => (
                    <div class="pl-4 border-l-2 border-brand-100 dark:border-brand-900">
                      <p class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wide mb-2">
                        {name}
                      </p>
                      <ul class="space-y-1.5">
                        {bullets.map(bullet => (
                          <li class="flex gap-2 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
                            <span class="text-brand-400 mt-1.5 shrink-0">›</span>
                            {bullet}
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ EDUCATION + CERTS -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="grid md:grid-cols-2 gap-12">

        <!-- Education -->
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Education</h2>
          <div class="space-y-6">
            {education.map(({ institution, degree, field, period }) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-lg bg-brand-50 dark:bg-brand-900/30
                            flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-500" fill="none"
                       viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M12 14l9-5-9-5-9 5 9 5z"/>
                    <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-slate-900 dark:text-white text-sm leading-snug">
                    {institution}
                  </p>
                  <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                    {degree} · {field}
                  </p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">{period}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Certifications -->
        <div>
          <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Certifications</h2>
          <div class="space-y-4">
            {certifications.map(({ name, issuer, year }) => (
              <div class="flex gap-4 p-3 rounded-xl
                          bg-slate-50 dark:bg-slate-900
                          border border-slate-200 dark:border-slate-800">
                <div class="w-8 h-8 rounded-lg bg-brand-50 dark:bg-brand-900/30
                            flex items-center justify-center shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-500" fill="none"
                       viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-semibold text-slate-800 dark:text-slate-200 leading-snug">
                    {name}
                  </p>
                  <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">
                    {issuer} · {year}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ TECH STACK -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Tech Stack</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { category: 'Languages',     items: ['TypeScript', 'JavaScript', 'Python'] },
          { category: 'Frontend',      items: ['React.js', 'Tailwind CSS', 'Astro'] },
          { category: 'Backend',       items: ['FastAPI', 'REST APIs', 'Async Python'] },
          { category: 'Infra / Cloud', items: ['AWS', 'GCP', 'Docker', 'Kubernetes'] },
          { category: 'Databases',     items: ['PostgreSQL', 'MongoDB'] },
          { category: 'Practices',     items: ['CI/CD', 'System Design', 'Agile'] },
        ].map(({ category, items }) => (
          <div class="p-4 rounded-xl bg-white dark:bg-slate-800
                      border border-slate-200 dark:border-slate-700">
            <p class="text-xs font-semibold text-slate-400 dark:text-slate-500 mb-3 uppercase tracking-wide">
              {category}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {items.map(item => (
                <span class="text-xs px-2 py-0.5 rounded-md
                             bg-slate-100 dark:bg-slate-700
                             text-slate-700 dark:text-slate-300 font-medium">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ CTA -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="rounded-2xl bg-brand-600 dark:bg-brand-700 p-8 sm:p-12 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          Interested in working together?
        </h2>
        <p class="text-brand-200 mb-8 max-w-lg mx-auto">
          I'm open to full-time roles, contract work, and technical conversations.
          Let's connect.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="mailto:sumitbatwani@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                   bg-white text-brand-700 hover:bg-brand-50 transition-colors"
          >
            Say Hello
          </a>
          <a
            href="https://linkedin.com/in/sumit-kumar-18816a83"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-sm
                   bg-brand-500 hover:bg-brand-400 text-white border border-brand-400
                   transition-colors"
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
