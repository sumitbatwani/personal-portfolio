---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();

function readingTime(body: string): number {
  return Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<Layout
  title="Blog — Sumit Kumar"
  description="Technical articles on software engineering, algorithms, system design, and engineering leadership by Sumit Kumar."
>
  <section class="py-16 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <p class="text-sm font-semibold text-brand-500 uppercase tracking-widest mb-3">Writing</p>
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-white mb-4">Blog</h1>
      <p class="text-lg text-slate-500 dark:text-slate-400">
        Thoughts on software engineering, system design, and building great products.
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} published.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">

      <!-- Tag filter -->
      {allTags.length > 1 && (
        <div class="flex flex-wrap gap-2 mb-10" id="tag-filters">
          <button
            data-tag="all"
            class="tag-btn active px-3 py-1.5 rounded-full text-xs font-semibold
                   bg-brand-600 text-white transition-all"
          >
            All
          </button>
          {allTags.map(tag => (
            <button
              data-tag={tag}
              class="tag-btn px-3 py-1.5 rounded-full text-xs font-semibold
                     bg-slate-100 dark:bg-slate-800
                     text-slate-600 dark:text-slate-400
                     hover:bg-brand-50 dark:hover:bg-brand-900/30
                     hover:text-brand-600 dark:hover:text-brand-400
                     transition-all"
            >
              {tag}
            </button>
          ))}
        </div>
      )}

      <!-- Post list -->
      <div class="space-y-6" id="post-list">
        {posts.map(post => {
          const slug = post.id.replace(/\.(md|mdx)$/, '');
          const rt   = readingTime(post.body ?? '');
          return (
            <article
              data-tags={post.data.tags.join(',')}
              class="post-card group"
            >
              <a
                href={`/blog/${slug}`}
                class="flex items-start gap-4 p-5 rounded-2xl
                       bg-white dark:bg-slate-900
                       border border-slate-200 dark:border-slate-800
                       hover:border-brand-300 dark:hover:border-brand-700
                       hover:shadow-lg hover:shadow-brand-500/5
                       transition-all duration-200 block"
              >
                <!-- Date column -->
                <div class="hidden sm:flex flex-col items-center justify-center
                            w-14 shrink-0 pt-0.5">
                  <span class="text-xl font-bold text-slate-900 dark:text-white leading-none">
                    {post.data.date.getDate()}
                  </span>
                  <span class="text-xs text-slate-400 uppercase tracking-wide mt-0.5">
                    {post.data.date.toLocaleDateString('en-GB', { month: 'short' })}
                  </span>
                  <span class="text-xs text-slate-400">
                    {post.data.date.getFullYear()}
                  </span>
                </div>

                <!-- Divider -->
                <div class="hidden sm:block w-px self-stretch bg-slate-200 dark:bg-slate-800" />

                <!-- Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-2">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span class="text-xs font-medium text-brand-600 dark:text-brand-400">
                        {tag}
                      </span>
                    ))}
                    <span class="text-slate-300 dark:text-slate-700">·</span>
                    <span class="text-xs text-slate-400">{rt} min read</span>
                    <span class="text-xs text-slate-400 sm:hidden">
                      · {formatDate(post.data.date)}
                    </span>
                  </div>

                  <h2 class="font-bold text-slate-900 dark:text-white text-lg leading-snug
                             group-hover:text-brand-600 dark:group-hover:text-brand-400
                             transition-colors">
                    {post.data.title}
                  </h2>

                  <p class="mt-2 text-sm text-slate-500 dark:text-slate-400 leading-relaxed line-clamp-2">
                    {post.data.description}
                  </p>
                </div>

                <!-- Arrow -->
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-5 w-5 text-slate-300 dark:text-slate-700 shrink-0 mt-1
                            group-hover:text-brand-500 group-hover:translate-x-1 transition-all duration-200"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cards   = document.querySelectorAll<HTMLElement>('.post-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? 'all';

      // Update active button
      buttons.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.classList.toggle('bg-brand-600', b === btn);
        b.classList.toggle('text-white', b === btn);
        b.classList.toggle('bg-slate-100', b !== btn);
        b.classList.toggle('dark:bg-slate-800', b !== btn);
        b.classList.toggle('text-slate-600', b !== btn);
        b.classList.toggle('dark:text-slate-400', b !== btn);
      });

      // Show/hide cards
      cards.forEach(card => {
        const tags = card.dataset.tags?.split(',') ?? [];
        card.style.display = (tag === 'all' || tags.includes(tag)) ? '' : 'none';
      });
    });
  });
</script>
