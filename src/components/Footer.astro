---
const year = new Date().getFullYear();

const socials = [
  {
    label: 'GitHub',
    href: 'https://github.com/sumitkumar',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
    </svg>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/in/sumitkumar',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>`,
  },
  {
    label: 'X / Twitter',
    href: 'https://x.com/sumitkumar',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>`,
  },
];
---

<footer class="mt-24 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">

      <!-- Name + tagline -->
      <div class="text-center sm:text-left">
        <p class="font-semibold text-slate-900 dark:text-white">Sumit Kumar</p>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
          Lead Software Engineer
        </p>
      </div>

      <!-- Social links -->
      <div class="flex items-center gap-3">
        {socials.map(({ href, label, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="p-2 rounded-md text-slate-400 hover:text-brand-600 dark:hover:text-brand-400
                   hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-150"
            set:html={icon}
          />
        ))}
      </div>
    </div>

    <!-- Copyright -->
    <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-600">
      © {year} Sumit Kumar. Built with
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer"
         class="hover:text-brand-500 transition-colors">Astro</a> &
      <a href="https://tailwindcss.com" target="_blank" rel="noopener noreferrer"
         class="hover:text-brand-500 transition-colors">Tailwind CSS</a>.
    </p>
  </div>
</footer>
